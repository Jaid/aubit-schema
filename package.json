{
  "name": "aubit-schema",
  "version": "0.1.0",
  "type": "module",
  "description": "Zod schema and TypeScript types for the Aubit report format",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/aubit-schema.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "rolldown -c",
    "test": "bun test --max-concurrency 1 ./test"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-jaid": "34.0.0",
    "fs-extra": "11.4.1",
    "rolldown": "1.2.12",
    "rolldown-plugin-dts": "0.28.6",
    "terser": "5.51.2",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4"
  }
}